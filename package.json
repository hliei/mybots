{
  "name": "mybots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @mybots/agent-runner",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace @mybots/agent-runner",
    "start:cli": "node dist/cli.js",
    "check:startup": "node scripts/check-startup.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:startup",
    "prepare": "husky",
    "demo:pi": "npm run build --workspace @mybots/agent-runner && npm run demo --workspace @mybots/agent-runner",
    "test:infrastructure": "docker build -t mybots-agent:mailbox -f container/Dockerfile . && vitest run --config tests/infrastructure/vitest.config.ts",
    "dev:host": "node src/index.ts",
    "start:host": "node dist/index.js",
    "demo:host": "npm run build && node scripts/host-cli-demo.mjs",
    "prebuild": "node scripts/clean-build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@onecli-sh/sdk": "2.2.1",
    "ws": "8.22.0"
  },
  "workspaces": [
    "container/agent-runner",
    "src/mailbox"
  ]
}
