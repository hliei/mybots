{
  "name": "mybots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:cli": "node src/cli.ts",
    "dev:bot": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "tsc -p tsconfig.build.json",
    "start:cli": "node dist/cli.js",
    "start:bot": "node dist/server.js",
    "check:startup": "node scripts/check-startup.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:startup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
