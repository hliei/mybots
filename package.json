{
  "name": "mybots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "npm run build --workspaces",
    "check:startup": "node scripts/check-startup.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:startup",
    "prepare": "husky",
    "demo:pi": "npm run build --workspace @mybots/mailbox && npm run build --workspace @mybots/agent-runner && npm run demo --workspace @mybots/agent-runner",
    "test:infrastructure": "docker build -t mybots-agent:mailbox -f container/Dockerfile . && vitest run --config tests/infrastructure/vitest.config.ts",
    "demo:host": "npm run build && node scripts/host-cli-demo.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "dev": "node --conditions=mybots-source packages/host/src/index.ts",
    "start": "node packages/host/dist/index.js",
    "mbt": "node packages/host/src/cli/client.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "packages/mailbox",
    "packages/host",
    "packages/agent-runner"
  ],
  "bin": {
    "mbt": "bin/mbt"
  }
}
