{
  "name": "mybots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:cli": "node src/cli.ts",
    "dev:bot": "node src/server.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @mybots/agent-runner",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:live": "vitest run --config tests/live/vitest.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace @mybots/agent-runner",
    "start:cli": "node dist/cli.js",
    "start:bot": "node dist/server.js",
    "check:startup": "node scripts/check-startup.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:startup",
    "prepare": "husky",
    "demo:pi": "npm run build --workspace @mybots/agent-runner && npm run demo --workspace @mybots/agent-runner"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.1.2",
    "openai": "7.32.0",
    "turndown": "7.2.4",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "container/agent-runner"
  ]
}
