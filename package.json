{
  "name": "mybots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "npm run build --workspaces",
    "check:startup": "node scripts/check-startup.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:startup && playwright test",
    "prepare": "husky",
    "test:infrastructure": "npm run build --workspace @mybots/web && npm run build:computer && vitest run --config tests/infrastructure/vitest.config.ts",
    "prebuild": "node scripts/clean-build.mjs",
    "dev": "node --conditions=mybots-source apps/api/src/index.ts",
    "start": "node apps/api/dist/index.js",
    "test:browser": "npm run build && playwright test",
    "build:computer": "docker build -t mybots-computer:local -f container/Computer.Dockerfile ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "packages/contracts",
    "packages/db",
    "packages/sandbox",
    "packages/agent",
    "apps/web",
    "apps/worker",
    "apps/api"
  ]
}
