#!/bin/sh
set -eu

mbt_path=$0
while [ -L "$mbt_path" ]; do
  mbt_directory=$(CDPATH= cd -- "$(dirname -- "$mbt_path")" && pwd)
  mbt_target=$(readlink "$mbt_path")
  case "$mbt_target" in
    /*) mbt_path=$mbt_target ;;
    *) mbt_path=$mbt_directory/$mbt_target ;;
  esac
done
mbt_root=$(CDPATH= cd -- "$(dirname -- "$mbt_path")/.." && pwd)
mbt_node=$mbt_root/.tools/node/bin/node
if [ ! -x "$mbt_node" ]; then
  mbt_node=node
fi
exec "$mbt_node" "$mbt_root/packages/host/src/cli/client.ts" "$@"
